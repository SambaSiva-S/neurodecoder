# ===== NEURODECODER ENVIRONMENT VARIABLES =====
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to Git — it's in .gitignore

# Anthropic Claude API Key (for AI Chat feature)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Hugging Face Token (for deployment)
HF_TOKEN=hf_your-token-here

# Optional: Custom settings
NEURODECODER_MAX_FILE_SIZE_MB=500
NEURODECODER_RATE_LIMIT_PER_MINUTE=10
NEURODECODER_API_BUDGET_SESSION=5.00
NEURODECODER_API_BUDGET_DAILY=25.00
NEURODECODER_API_BUDGET_MONTHLY=200.00
